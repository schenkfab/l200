# Choose one authentication method:

# Option 1: Google Cloud Secret Manager (Recommended for Production)
USE_SECRET_MANAGER=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Option 2: Local Development with Google AI Studio API Key (Fallback)
# USE_SECRET_MANAGER=false
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-google-api-key-here

# Strategic Model Routing Overrides
BLOG_FAST_MODEL=gemini-2.5-flash
BLOG_REASONING_MODEL=gemini-2.5-pro

# Persistent Session & Observability Settings
BLOG_SESSION_DB_URL=sqlite:///./blog_writer_sessions.db
ENABLE_CONSOLE_TRACING=false
